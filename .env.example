# ---------------------------------------------------------------------------
# stdio mode (single account, runs on your machine)
# ---------------------------------------------------------------------------
# Username is the email you log in with. The token is generated in
# SmartBill Cloud > Contul meu > Integrari > API.
SMARTBILL_USERNAME=you@example.com
SMARTBILL_TOKEN=your-api-token
SMARTBILL_VAT_CODE=RO12345678

# Optional — default series, so tools can be called without `seriesName`.
# Run the list_series tool to see the series configured on the account.
SMARTBILL_INVOICE_SERIES=FF
SMARTBILL_ESTIMATE_SERIES=PF
SMARTBILL_RECEIPT_SERIES=CH

# ---------------------------------------------------------------------------
# HTTP mode (multi-tenant, hosted). Start with `--http` or MCP_TRANSPORT=http.
# Credentials arrive with each request, so none of the SMARTBILL_* secrets
# above are read in this mode.
# ---------------------------------------------------------------------------
# MCP_TRANSPORT=http
# PORT=80
# HOST=0.0.0.0
# MCP_PATH=/mcp

# Comma-separated Host header values to accept, for DNS rebinding protection.
# Leave unset to accept any Host.
# MCP_ALLOWED_HOSTS=smartbill-coolify.example.com

# ---------------------------------------------------------------------------
# Both modes
# ---------------------------------------------------------------------------
# Where PDFs are written when delivered as files. Default: ./smartbill-downloads
# SMARTBILL_DOWNLOAD_DIR=./smartbill-downloads

# Override the API base URL. Default: https://ws.smartbill.ro/SBORO/api
# SMARTBILL_BASE_URL=https://ws.smartbill.ro/SBORO/api
